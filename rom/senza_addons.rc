# Senza Addon's - eksekutor ROM (TANPA root di aplikasi)
# Pasang di: /system/etc/init/senza_addons.rc  (0644, u:object_r:system_file:s0)
# Aplikasi Pengaturan hanya mengubah system property; skrip ini yang menulis sysfs.

on property:persist.sys.senza.cfg=*
    exec_background u:r:init:s0 root root -- /system/bin/sh /system/bin/senza_apply.sh ${persist.sys.senza.cfg}

on property:sys.senza.cfg=*
    exec_background u:r:init:s0 root root -- /system/bin/sh /system/bin/senza_apply.sh ${sys.senza.cfg}

# Terapkan ulang pengaturan tersimpan setelah boot
on property:sys.boot_completed=1
    exec_background u:r:init:s0 root root -- /system/bin/sh /system/bin/senza_apply.sh ${persist.sys.senza.cfg:-}
